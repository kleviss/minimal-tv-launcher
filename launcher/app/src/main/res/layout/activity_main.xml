<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen, the "hybrid" design (docs/design/mockups/d-hybrid.html). Mockup px / 2 = dp on this 320 dpi TV.
     Layers, bottom to top: wallpaper, two soft scrims, the chrome, the rounded-corner mask (added in code). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipChildren="false">

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- Radial lift behind the clock block and a linear lift under the dock; both painted in code in the
         region's tint so they darken on a dark pair and lighten on a light one. -->
    <View
        android:id="@+id/scrimTop"
        android:layout_width="match_parent"
        android:layout_height="280dp" />

    <View
        android:id="@+id/scrimDock"
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:layout_gravity="bottom" />

    <!-- Top right: the three pills. -->
    <LinearLayout
        android:id="@+id/pills"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="36dp"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false">

        <TextView
            android:id="@+id/btnInputs"
            style="@style/Pill"
            android:text="@string/inputs" />

        <TextView
            android:id="@+id/btnNetwork"
            style="@style/Pill"
            android:maxWidth="190dp"
            android:drawableStart="@drawable/ic_wifi"
            android:text="@string/wifi" />

        <TextView
            android:id="@+id/btnSettings"
            style="@style/Pill"
            android:text="@string/settings" />
    </LinearLayout>

    <!-- Top centre: greeting, clock, date. -->
    <LinearLayout
        android:id="@+id/lock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="78dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:alpha="0.8"
            android:textSize="15sp"
            android:fontFamily="sans-serif" />

        <TextClock
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:textSize="75sp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="-0.02" />

        <TextClock
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:format12Hour="EEEE d MMMM"
            android:format24Hour="EEEE d MMMM"
            android:singleLine="true"
            android:textSize="18sp"
            android:fontFamily="sans-serif" />
    </LinearLayout>

    <!-- Bottom: the focused app's name, the row of tiles, then VPN status left and Add app right. -->
    <LinearLayout
        android:id="@+id/dockBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="36dp"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <TextView
            android:id="@+id/appName"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="-1dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:textSize="32sp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="-0.01" />

        <!-- Scrolls sideways once more apps are pinned than fit. Tiles are 192x108dp with 20dp gaps. -->
        <HorizontalScrollView
            android:id="@+id/dockScroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/dock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:clipChildren="false"
                android:clipToPadding="false" />
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="14dp"
            android:clipChildren="false">

            <!-- A status label, not a button: no material, a dot and text straight on the dock lift. -->
            <TextView
                android:id="@+id/vpnStatus"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="start|center_vertical"
                android:gravity="center_vertical"
                android:drawableStart="@drawable/ic_dot"
                android:drawablePadding="6dp"
                android:singleLine="true"
                android:text="@string/vpn_off"
                android:textSize="13sp"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/btnAdd"
                style="@style/Pill"
                android:layout_gravity="end|center_vertical"
                android:layout_marginStart="0dp"
                android:drawableStart="@drawable/ic_add"
                android:text="@string/add_app" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
