<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipChildren="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="28dp"
        android:paddingBottom="28dp">

        <!-- Header: greeting, time and date on the left, pills on the right. -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/topButtons"
                android:layout_marginEnd="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/greeting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textAllCaps="true"
                    android:textColor="@color/text_dim"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.22" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:baselineAligned="false">

                    <TextClock
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:includeFontPadding="false"
                        android:textColor="@color/text"
                        android:textSize="56sp"
                        android:fontFamily="sans-serif-light"
                        android:letterSpacing="-0.03" />

                    <TextClock
                        android:id="@+id/ampm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginBottom="9dp"
                        android:format12Hour="a"
                        android:format24Hour=""
                        android:textAllCaps="true"
                        android:textColor="@color/text_dim"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.08" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="9dp"
                        android:background="#33FFFFFF" />

                    <TextClock
                        android:id="@+id/date"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="9dp"
                        android:format12Hour="EEEE  d MMMM"
                        android:format24Hour="EEEE  d MMMM"
                        android:singleLine="true"
                        android:textAllCaps="true"
                        android:textColor="@color/text_dim"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="12sp"
                        android:autoSizeMaxTextSize="18sp"
                        android:autoSizeStepGranularity="1sp"
                        android:fontFamily="sans-serif"
                        android:letterSpacing="0.12" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnInputs"
                    style="@style/Pill"
                    android:drawableStart="@drawable/ic_input"
                    android:text="@string/inputs" />

                <TextView
                    android:id="@+id/btnNetwork"
                    style="@style/Pill"
                    android:maxWidth="170dp"
                    android:drawableStart="@drawable/ic_wifi"
                    android:text="@string/wifi" />

                <TextView
                    android:id="@+id/btnSettings"
                    style="@style/Pill"
                    android:drawableStart="@drawable/ic_settings"
                    android:text="@string/settings" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Dock area, centred in the space under the header: the row of pinned apps, Add app pill below it. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Scrolls sideways once more apps are pinned than fit on screen. -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:id="@+id/dock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:clipChildren="false"
                    android:clipToPadding="false" />
            </HorizontalScrollView>

            <!-- Under the row: VPN status on the left, Add app on the right. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/vpnStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_gravity="start"
                    android:layout_marginStart="14dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="20dp"
                    android:gravity="center"
                    android:background="@drawable/chip_bg"
                    android:drawableStart="@drawable/ic_dot"
                    android:drawablePadding="10dp"
                    android:singleLine="true"
                    android:text="@string/vpn_off"
                    android:textColor="@color/text_dim"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/btnAdd"
                    style="@style/Pill"
                    android:layout_gravity="end"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="14dp"
                    android:drawableStart="@drawable/ic_add"
                    android:text="@string/add_app" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
